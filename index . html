<script>
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
lucide.createIcons();

/* Nav */
$('#burger').onclick=()=>{const m=$('#mnav'),o=m.classList.toggle('hidden');m.classList.toggle('flex',!o);$('#burger').setAttribute('aria-expanded',!o)};
$$('#mnav a').forEach(a=>a.onclick=()=>{$('#mnav').classList.add('hidden');$('#mnav').classList.remove('flex')});

/* Sandbox */
const samples={churn:{customer_id:"C-1042",tenure_months:7,monthly_charges:78.5,support_tickets:4,contract:"month-to-month"},
fraud:{transaction_id:"T-90311",amount:4850,currency:"USD",merchant_category:"electronics",country:"NG",hour:3,card_present:false}};
let ep='churn';const body=$('#body');
const fill=()=>body.value=JSON.stringify(samples[ep],null,2);fill();
$$('.ep').forEach(b=>b.onclick=()=>{ep=b.dataset.ep;$$('.ep').forEach(x=>{x.className='btn text-sm ep '+(x===b?'btn-p':'btn-g')});fill()});
$('#rst').onclick=fill;
const hl=j=>JSON.stringify(j,null,2).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/("[^"]+")(:)|("[^"]*")|(\b-?\d+\.?\d*\b)/g,(m,k,c,s,n)=>k?`<span class="k">${k}</span>:`:s?`<span class="s">${s}</span>`:`<span class="n">${n}</span>`);
function model(d){
 if(ep==='churn'){let p=.1+Math.min(+d.support_tickets||0,8)*.07+Math.max(0,12-(+d.tenure_months||0))*.02+(d.contract==="month-to-month"?.12:0);p=Math.min(.98,p);
  return{customer_id:d.customer_id,churn_probability:+p.toFixed(3),risk_band:p>.65?"high":p>.4?"medium":"low",top_factors:["support_tickets","tenure_months","contract"],model_version:"churn-gbm-1.3.0"}}
 let s=.05;if(+d.amount>2000)s+=.3;if(+d.hour<5)s+=.2;if(d.card_present===false)s+=.15;if(["NG","RU","KP"].includes(d.country))s+=.2;s=Math.min(.99,s);
 return{transaction_id:d.transaction_id,fraud_score:+s.toFixed(3),decision:s>.7?"block":s>.4?"review":"approve",reasons:["amount","hour","card_present","country"],model_version:"fraud-xgb-2.1.0"}}
$('#send').onclick=()=>{
 const b=$('#badge'),o=$('#out');b.textContent='Sending…';b.style.cssText='background:#16233f;color:var(--mute)';const t0=performance.now();
 setTimeout(()=>{let ok=true,r;
  try{const d=JSON.parse(body.value);const need=ep==='churn'?'customer_id':'transaction_id';if(!d[need])throw new Error('Field required: '+need);r=model(d)}
  catch(e){ok=false;r={detail:[{loc:["body"],msg:e.message,type:"value_error"}]}}
  b.textContent=ok?'200 OK':'422 Unprocessable Entity';b.style.cssText=ok?'background:rgba(52,211,153,.15);color:var(--ok)':'background:rgba(248,113,113,.15);color:var(--bad)';
  $('#lat').textContent='Latency: '+Math.round(performance.now()-t0)+' ms';o.innerHTML=hl(r)},260+Math.random()*200)};

/* Modals */
let last;const open=(id)=>{last=document.activeElement;$(id).classList.add('open');const f=$(id).querySelector('input,a,button');f&&f.focus()};
const closeAll=()=>{$$('.ov.open').forEach(m=>{if(m.id!=='cwin')m.classList.remove('open')});last&&last.focus&&last.focus()};
$$('[data-book]').forEach(b=>b.onclick=()=>{$('#bf').classList.remove('hidden');$('#bd').classList.add('hidden');$('#ferr').textContent='';open('#bm')});
$('#prev').onclick=()=>open('#em');
$$('.x').forEach(x=>x.onclick=closeAll);
$$('#bm,#em').forEach(m=>m.addEventListener('click',e=>{if(e.target===m)closeAll()}));
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeAll()});
const buy=e=>{e.preventDefault();alert('Add your Gumroad, Payhip or Stripe link to the Buy buttons.')};
$('#buy').onclick=buy;$('.buyl').onclick=buy;
$('#fsub').onclick=()=>{const n=$('#fn').value.trim(),e=$('#fe').value.trim();
 if(!n||!/^\S+@\S+\.\S+$/.test(e)||!$('#fd').value.trim()){$('#ferr').textContent='Add your name, a valid email and a few project details.';return}
 $('#bdt').textContent='Thanks '+n+'. We’ll email '+e+' about '+$('#fs').value+' within one business day.';$('#bf').classList.add('hidden');$('#bd').classList.remove('hidden');lucide.createIcons()};

/* Chatbot */
const kb=[
[/stack|tech|tool|python|fastapi|docker|pydantic/,"Our stack: Python, scikit-learn and PyTorch for modeling, FastAPI with Pydantic for APIs, and Docker for deployment."],
[/churn|fraud|predict|model|ml|machine/,"Predictive ML is our core service: churn prediction, fraud detection and forecasting. Try both on the API Sandbox."],
[/api|backend|architecture/,"We build FastAPI backends with Pydantic validation, containerized with Docker. See the API Sandbox for the response format."],
[/consult|strategy|automation|pipeline|data/,"Our consulting service covers data pipelines, automation and an AI roadmap focused on measurable return."],
[/book|call|meeting|schedule|start|hire|contact/,"You can book a free strategy call with the Book Strategy Call button. Tell us your service, budget range and project details."],
[/price|cost|budget|rate/,"Budgets start under $1,000 for small builds. Pick a range in the booking form and we’ll scope it with you."],
[/ebook|book|blueprint|guide/,"“The Machine Learning Blueprint” is our technical eBook. Open the Knowledge Hub to preview the chapters."]];
const msgs=$('#msgs');
const add=(t,c)=>{const d=document.createElement('div');d.className='bub '+c;d.textContent=t;msgs.appendChild(d);msgs.scrollTop=msgs.scrollHeight};
add("Hi, I’m the DataPulse assistant. Ask me about our services, tech stack or booking a call.","bot");
["Services","Tech stack","Book a call"].forEach(c=>{const b=document.createElement('button');b.className='px-2 py-1 rounded-full card';b.textContent=c;b.onclick=()=>say(c);$('#chips').appendChild(b)});
function say(v){add(v,'me');setTimeout(()=>{const m=kb.find(k=>k[0].test(v.toLowerCase()));
 add(m?m[1]:"I can answer questions about services, tech stack, pricing or booking. Which would you like?","bot");
 if(m&&/book a call|book|call/.test(v.toLowerCase()))setTimeout(()=>$('[data-book]').click(),500)},350)}
$('#cbtn').onclick=()=>{const o=$('#cwin').classList.toggle('open');$('#cbtn').setAttribute('aria-expanded',o);if(o)$('#cin').focus()};
const go=()=>{const v=$('#cin').value.trim();if(v){$('#cin').value='';say(v)}};
$('#csend').onclick=go;$('#cin').addEventListener('keydown',e=>{if(e.key==='Enter')go()});
</script>
